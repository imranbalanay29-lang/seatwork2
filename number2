#include <iostream>
using namespace std ;

int main()
{
    int number1, number2;
    char operation;
    
    cout << "Enter first number: " ;
    cin >> number1 ;
    
    cout << "Enter operation (+, -, *, /) : " ;
    cin >> operation;
    
    cout << "Enter second number: " ;
    cin >> number2 ;
    
    if(operation == '+') {
        cout << "answer: " << number1 + number2 ;
    } else if (operation == '-') {
        cout << "answer: " << number1 - number2 ;
    } else if (operation == '*') {
        cout << "answer: " << number1 * number2 ;
    } else if (operation == '/') {
        cout << "answer: " << number1 / number2 ;
    } else{
        cout << "invalid operation" ;
    }

    return 0;
}
